{
	"name": "wip-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Work-in-progress inventory and prioritization CLI",
	"bin": {
		"wip": "./packages/cli/bin/run.js"
	},
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "pnpm -r run build",
		"typecheck": "pnpm -r run typecheck",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes --no-create-config",
		"fallow:ci": "fallow dead-code",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.5",
		"eslint-plugin-storybook": "^10.6.2",
		"fallow": "^3.35.0",
		"markdownlint-cli2": "^0.23.3",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.12.1"
}
