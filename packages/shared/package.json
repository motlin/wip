{
	"name": "@wip/shared",
	"version": "0.0.0",
	"description": "Shared code between CLI and web packages",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./inventory-import.js": {
			"types": "./src/lib/inventory-import.ts",
			"import": "./src/lib/inventory-import.ts"
		},
		"./classify.js": {
			"types": "./src/lib/classify.ts",
			"import": "./src/lib/classify.ts"
		},
		"./git-child-discriminators.js": {
			"types": "./src/lib/git-child-discriminators.ts",
			"import": "./src/lib/git-child-discriminators.ts"
		},
		"./candidate-rank.js": {
			"types": "./src/lib/candidate-rank.ts",
			"import": "./src/lib/candidate-rank.ts"
		},
		"./ready-slots.js": {
			"types": "./src/lib/ready-slots.ts",
			"import": "./src/lib/ready-slots.ts"
		},
		"./readiness.js": {
			"types": "./src/lib/readiness.ts",
			"import": "./src/lib/readiness.ts"
		},
		"./upstream-red.js": {
			"types": "./src/lib/upstream-red.ts",
			"import": "./src/lib/upstream-red.ts"
		},
		"./schemas.js": {
			"types": "./src/lib/schemas.ts",
			"import": "./src/lib/schemas.ts"
		},
		"./services/telemetry.js": {
			"types": "./src/services/telemetry.ts",
			"import": "./src/services/telemetry.ts"
		},
		"./services/subprocess-gate.js": {
			"types": "./src/services/subprocess-gate.ts",
			"import": "./src/services/subprocess-gate.ts"
		},
		"./services/traced-execa.js": {
			"types": "./src/services/traced-execa.ts",
			"import": "./src/services/traced-execa.ts"
		},
		"./services/logger-pino.js": {
			"types": "./src/services/logger-pino.ts",
			"import": "./src/services/logger-pino.ts"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"test": "node node_modules/vitest/dist/cli.js run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
		"@opentelemetry/instrumentation-http": "^0.223.0",
		"@opentelemetry/sdk-node": "^0.223.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"execa": "^10.1.1",
		"json5": "^2.2.3",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@pollyjs/adapter-fetch": "^6.0.7",
		"@pollyjs/core": "^6.0.6",
		"@pollyjs/persister-fs": "^6.0.6",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
